<Window x:Class="BitldzhemDocFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документооборот — ООО «Битлджем»"
        Height="800" Width="1340"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico"
        FontFamily="Segoe UI"
        Background="#FFF7F5F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Боковое меню (графит) ═══ -->
        <Border Grid.Column="0" Background="#FF1A1A1A">
            <DockPanel>
                <!-- Шапка с монограммой -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="50" CornerRadius="25"
                                BorderBrush="#FFC0A062" BorderThickness="1.5">
                            <TextBlock Text="Б" FontSize="26" FontWeight="Light"
                                       Foreground="#FFC0A062"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="БИТЛДЖЕМ" Foreground="#FFFFFFFF"
                                       FontSize="19" FontWeight="Light"/>
                            <TextBlock Text="Документооборот" Foreground="#FF8A8578"
                                       FontSize="22"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#FF2E2E2E" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Низ: пользователь + выход -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Rectangle Height="1" Fill="#FF2E2E2E" Margin="8,0,8,14"/>
                    <TextBlock x:Name="UserNameText" Foreground="#FFFFFFFF"
                               FontSize="26" Margin="8,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UserRoleText" Foreground="#FFC0A062"
                               FontSize="17" Margin="8,2,8,12"/>
                    <Button Content="Выйти" Click="Logout_Click"
                            HorizontalAlignment="Stretch" Height="40"
                            FontSize="26" FontWeight="SemiBold" Cursor="Hand"
                            Foreground="#FF1A1A1A" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#FFF7F5F0"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FFC0A062"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Пункты меню -->
                <StackPanel x:Name="MenuPanel" Margin="16,0"/>
            </DockPanel>
        </Border>

        <!-- ═══ Рабочая область ═══ -->
        <Border Grid.Column="1" Background="#FFF7F5F0">
            <ContentControl x:Name="ContentArea" Margin="24"/>
        </Border>
    </Grid>
</Window>
