<Window x:Class="BitldzhemDocFlow.Views.BatchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая партия продукции"
        Height="260" Width="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#FFF7F5F0"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация партии продукции"
                   FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Тех. карта:" Width="110" VerticalAlignment="Center"/>
            <ComboBox x:Name="CardCombo" Width="320" DisplayMemberPath="CardName"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Номер партии:" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="BatchNumberBox" Width="320"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="165" Click="Save_Click" FontSize="22"/>
            <Button Content="Отмена" Width="130" Click="Cancel_Click" FontSize="22"/>
        </StackPanel>
    </Grid>
</Window>
